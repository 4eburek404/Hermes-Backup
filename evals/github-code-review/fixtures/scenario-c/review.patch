diff --git a/src/events.py b/src/events.py
--- a/src/events.py
+++ b/src/events.py
@@ -1,2 +1,5 @@
-def encode_event(event: dict) -> dict:
-    return {"id": event["id"], "type": event["type"], "payload": event["payload"]}
+def encode_event(event: dict, *, include_metadata: bool = False) -> dict:
+    result = {"id": event["id"], "type": event["type"], "payload": event["payload"]}
+    if include_metadata:
+        result["metadata"] = event.get("metadata", {})
+    return result
diff --git a/tests/test_events.py b/tests/test_events.py
--- a/tests/test_events.py
+++ b/tests/test_events.py
@@ -1,15 +1,19 @@
 import unittest
 
 from src.events import encode_event
 
 
 class EventTests(unittest.TestCase):
-    def test_existing_wire_mapping_is_unchanged(self):
+    def test_existing_wire_mapping_is_unchanged_by_default(self):
         self.assertEqual(
             encode_event({"id": "e1", "type": "created", "payload": {"x": 1}}),
             {"id": "e1", "type": "created", "payload": {"x": 1}},
         )
 
+    def test_optional_metadata_is_exposed_when_requested(self):
+        event = {"id": "e1", "type": "created", "payload": {}, "metadata": {"source": "test"}}
+        self.assertEqual(encode_event(event, include_metadata=True)["metadata"], {"source": "test"})
+
 
 if __name__ == "__main__":
     unittest.main()
