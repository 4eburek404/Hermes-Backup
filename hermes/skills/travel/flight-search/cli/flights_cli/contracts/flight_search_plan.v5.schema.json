{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_search_plan.v5.schema.json",
  "title": "Flight Search Plan v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "phases",
    "gateway_policy",
    "execution_policy",
    "decision_policy",
    "output_policy",
    "planning_reasons"
  ],
  "properties": {
    "schema_version": {"const": "flight_search_plan.v5"},
    "route": {"$ref": "#/$defs/route"},
    "phases": {"$ref": "#/$defs/phases"},
    "gateway_policy": {"$ref": "#/$defs/gateway_policy"},
    "execution_policy": {"$ref": "#/$defs/execution_policy"},
    "decision_policy": {"$ref": "#/$defs/decision_policy"},
    "output_policy": {"$ref": "#/$defs/output_policy"},
    "planning_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "destination",
        "dates",
        "currency",
        "profile",
        "provider_policy",
        "routing_strategy",
        "route_mode",
        "market_class",
        "route_families",
        "hubs",
        "origin_airports",
        "destination_airports",
        "airport_scope",
        "direct_only"
      ],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depart", "return"],
          "properties": {
            "depart": {"type": "string", "format": "date"},
            "return": {"type": ["string", "null"], "format": "date"},
            "window_end": {"type": "string", "format": "date"}
          }
        },
        "currency": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "provider_policy": {"type": "string", "minLength": 1},
        "routing_strategy": {"type": "string", "minLength": 1},
        "route_mode": {"type": "string", "minLength": 1},
        "market_class": {"type": "string", "minLength": 1},
        "route_families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {"id": {"type": "string", "minLength": 1}}
          }
        },
        "hubs": {"type": "array", "items": {"type": "string"}},
        "origin_airports": {"type": "array", "items": {"type": "string"}},
        "destination_airports": {"type": "array", "items": {"type": "string"}},
        "airport_scope": {"type": ["object", "null"]},
        "direct_only": {"type": "boolean"}
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "gateway"],
      "properties": {
        "primary": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "gateway": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "phase",
        "trigger",
        "provider",
        "probe_type",
        "direction",
        "query"
      ],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["primary", "gateway"]},
        "trigger": {
          "enum": [
            "always",
            "no_direct",
            "disabled",
            "required_if_no_direct",
            "on_primary_failure"
          ]
        },
        "provider": {"type": "string", "minLength": 1},
        "probe_type": {
          "enum": [
            "segment_direct",
            "segment_hub_leg",
            "full_route_aggregate",
            "carrier_aggregate"
          ]
        },
        "direction": {"enum": ["outbound", "return"]},
        "query": {"$ref": "#/$defs/attempt_query"}
      }
    },
    "attempt_query": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "probe_id",
            "phase",
            "trigger",
            "provider",
            "probe_type",
            "direction",
            "execution_state"
          ]
        }
      },
      "required": [
        "role",
        "source_type",
        "origin",
        "destination",
        "date",
        "currency",
        "direct_only"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "origin": {"type": "string"},
        "destination": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "currency": {"type": "string"},
        "direct_only": {"type": "boolean"}
      }
    },
    "gateway_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "discovery"],
      "properties": {
        "trigger": {
          "enum": ["disabled", "required_if_no_direct", "on_primary_failure"]
        },
        "discovery": {
          "type": "object",
          "required": [
            "enabled",
            "reason",
            "mode",
            "route_access_profile",
            "route_access_reasons",
            "candidate_count",
            "candidates",
            "skipped_reasons",
            "empty_reason"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "reason": {"type": ["string", "null"]},
            "mode": {"type": "string"},
            "route_access_profile": {"type": ["string", "null"]},
            "route_access_reasons": {"type": "array", "items": {"type": "string"}},
            "candidate_count": {"type": "integer", "minimum": 0},
            "candidates": {"type": "array", "items": {"type": "object"}},
            "skipped_reasons": {"type": "array", "items": {"type": "string"}},
            "empty_reason": {"type": ["string", "null"]}
          }
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_provider_attempts",
        "segment_limit",
        "live_cache_ttl_seconds",
        "live_cache_enabled",
        "timeout",
        "fail_fast",
        "gateway_discovery_limit",
        "gateway_probe_batch_size",
        "gateway_probe_max_batches",
        "only_carriers"
      ],
      "properties": {
        "max_provider_attempts": {"type": "integer", "minimum": 1},
        "segment_limit": {"type": "integer", "minimum": 1},
        "live_cache_ttl_seconds": {"type": "integer", "minimum": 0},
        "live_cache_enabled": {"type": "boolean"},
        "timeout": {"type": "integer", "minimum": 1},
        "fail_fast": {"type": "boolean"},
        "gateway_discovery_limit": {"type": "integer", "minimum": 0},
        "gateway_probe_batch_size": {"type": "integer", "minimum": 0},
        "gateway_probe_max_batches": {"type": "integer", "minimum": 0},
        "only_carriers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_connections_per_journey",
        "preferred_connections",
        "min_same_airport_connection_min",
        "min_cross_airport_connection_min",
        "max_layover_min",
        "preferred_layover_max_min"
      ],
      "properties": {
        "max_connections_per_journey": {"type": "integer", "minimum": 0},
        "preferred_connections": {"type": "integer", "minimum": 0},
        "min_same_airport_connection_min": {"type": "integer", "minimum": 0},
        "min_cross_airport_connection_min": {"type": "integer", "minimum": 0},
        "max_layover_min": {"type": "integer", "minimum": 0},
        "preferred_layover_max_min": {"type": "integer", "minimum": 0}
      }
    },
    "output_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_limit",
        "direct_catalog_limit",
        "max_gateway_alternatives",
        "max_primary_gateway_options",
        "max_options_per_first_carrier",
        "max_round_trip_pairs"
      ],
      "properties": {
        "catalog_limit": {"type": "integer", "minimum": 1},
        "direct_catalog_limit": {"type": "integer", "minimum": 1},
        "max_gateway_alternatives": {"type": "integer", "minimum": 0},
        "max_primary_gateway_options": {"type": "integer", "minimum": 0},
        "max_options_per_first_carrier": {"type": "integer", "minimum": 1},
        "max_round_trip_pairs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
