{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_search_request.v1.schema.json",
  "title": "Flight Search Request v1",
  "description": "Что просит путешественник. Настройки исполнения сюда не входят: они живут в конфигурации и ключах командной строки.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "destination",
    "depart_date"
  ],
  "properties": {
    "schema_version": {
      "const": "flight_search_request.v1"
    },
    "origin": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "destination": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "depart_date": {
      "type": "string",
      "format": "date"
    },
    "return_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "date_window_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Смотреть каждый день от depart_date до этой даты включительно. Несовместимо с return_date."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "provider_policy": {
      "type": "string",
      "minLength": 1
    },
    "max_connections": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Жёсткий потолок пересадок. Ноль — только прямые."
    },
    "preferred_connections": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Сколько пересадок предпочтительно. Не выше max_connections."
    },
    "only_carriers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]{2,3}$"
      }
    },
    "origin_airports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "description": "Какие аэропорты города отправления годятся. Пусто — решает каталог."
    },
    "destination_airports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "Сколько вариантов показать."
    }
  }
}
