{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/flight-calendar-ics-cli.v1.json",
  "title": "flight-calendar-ics compact CLI stdout v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "media",
        "segments_count",
        "no_further_action_needed"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "media": {
          "type": "string",
          "pattern": "^MEDIA:/"
        },
        "segments_count": {
          "type": "integer",
          "minimum": 1
        },
        "no_further_action_needed": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
