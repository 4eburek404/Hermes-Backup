{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/flight-calendar-ics-cli.v1.json",
  "title": "flight-calendar-ics CLI envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "command",
    "process"
  ],
  "properties": {
    "schema_version": {
      "const": "flight-calendar-ics-cli.v1"
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "enum": [
        "doctor",
        "validate",
        "make",
        "build",
        "aeroflot",
        "ural",
        "utair",
        "redwings",
        "diagnose",
        "maint"
      ]
    },
    "process": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "route": {
            "type": "string",
            "enum": [
              "make",
              "aeroflot",
              "ural",
              "utair",
              "redwings"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0
          },
          "schema_version": {
            "type": "string"
          },
          "segments_count": {
            "type": "integer",
            "minimum": 0
          },
          "artifact": {
            "type": "string",
            "enum": [
              "json",
              "ics",
              "envelope"
            ]
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{3,4}$"
          },
          "overrides_count": {
            "type": "integer",
            "minimum": 0
          },
          "defaults_count": {
            "type": "integer",
            "minimum": 0
          },
          "catalog_timezones_count": {
            "type": "integer",
            "minimum": 0
          },
          "catalog_source": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "entrypoint_kind": {
          "const": "single-python-executable"
        },
        "schema_version": {
          "const": "flight-calendar-ics-cli.v1"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "doctor",
              "validate",
              "make",
              "build",
              "aeroflot",
              "ural",
              "utair",
              "redwings",
              "diagnose",
              "maint"
            ]
          }
        },
        "surface": {
          "type": "string",
          "enum": [
            "production",
            "diagnostic",
            "maintenance",
            "compatibility"
          ]
        },
        "subcommand": {
          "type": "string"
        },
        "command_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "production",
            "diagnostic",
            "maintenance",
            "compatibility"
          ],
          "properties": {
            "production": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "diagnostic": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maintenance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "compatibility": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "legacy_scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "json_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "process": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        },
        "input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "schema_path"
          ],
          "properties": {
            "schema_version": {
              "const": "flight-calendar-ics-itinerary.v1"
            },
            "schema_path": {
              "type": "string"
            }
          }
        },
        "sensitive_stdout_policy": {
          "type": "string"
        },
        "agent_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal_steps",
            "dispatch_matrix",
            "verification",
            "privacy"
          ],
          "properties": {
            "normal_steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "instruction"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "collect_source",
                      "run_one_command",
                      "verify",
                      "deliver"
                    ]
                  },
                  "instruction": {
                    "type": "string"
                  }
                }
              }
            },
            "dispatch_matrix": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "command",
                  "route",
                  "argv_template"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string",
                    "enum": [
                      "build",
                      "make",
                      "aeroflot",
                      "ural",
                      "utair",
                      "redwings"
                    ]
                  },
                  "route": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "make",
                      "aeroflot",
                      "ural",
                      "utair",
                      "redwings"
                    ]
                  },
                  "argv_template": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "alternate_argv_template": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "anti_path": {
                    "type": "string"
                  }
                }
              }
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "envelope",
                "bundle"
              ],
              "properties": {
                "envelope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "bundle": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "privacy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chat_summary_must_omit"
              ],
              "properties": {
                "chat_summary_must_omit": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "segments_count": {
          "type": "integer",
          "minimum": 0
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "flight_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "route": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dtstart_utc": {
                "type": "string"
              },
              "dtend_utc": {
                "type": "string"
              },
              "departure_local": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "arrival_local": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "write_performed": {
          "type": "boolean"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command_registry_present": {
              "type": "boolean"
            },
            "production_happy_path_present": {
              "type": "boolean"
            },
            "diagnose_namespace_present": {
              "type": "boolean"
            },
            "maint_namespace_present": {
              "type": "boolean"
            }
          }
        },
        "source_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_shared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "same_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_count": {
          "type": "integer",
          "minimum": 0
        },
        "ics_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "json_path": {
          "type": "string"
        },
        "envelope_path": {
          "type": "string"
        },
        "output_dir": {
          "type": "string"
        },
        "route": {
          "type": "string",
          "enum": [
            "make",
            "aeroflot",
            "ural",
            "utair",
            "redwings"
          ]
        },
        "route_detection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "route",
            "confidence",
            "evidence"
          ],
          "properties": {
            "mode": {
              "const": "auto"
            },
            "route": {
              "type": "string",
              "enum": [
                "make",
                "aeroflot",
                "ural",
                "utair",
                "redwings"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "event_count"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "event_count": {
              "type": "integer",
              "minimum": 0
            },
            "utc_datetime_count": {
              "type": "integer",
              "minimum": 0
            },
            "placeholder_free": {
              "type": "boolean"
            },
            "private_modes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "json": {
                  "type": "string",
                  "pattern": "^[0-7]{3,4}$"
                },
                "ics": {
                  "type": "string",
                  "pattern": "^[0-7]{3,4}$"
                }
              }
            },
            "error": {
              "type": "string"
            }
          }
        },
        "source_path": {
          "type": "string"
        },
        "runtime_path": {
          "type": "string"
        },
        "registry_path": {
          "type": "string"
        },
        "catalog_path": {
          "type": "string"
        },
        "bundle_dir": {
          "type": "string"
        },
        "carrier": {
          "type": "string"
        },
        "catalog_schema_version": {
          "type": "string"
        },
        "generated_ignored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references_seen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unregistered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "broken_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample_airports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_contents_included": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "deletions_performed": {
          "type": "boolean"
        },
        "private_contents_printed": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "airports_count": {
          "type": "integer",
          "minimum": 0
        },
        "timezones_count": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "object"
        },
        "reports": {
          "type": "object"
        },
        "safe_adapter_metadata": {
          "type": "object"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "safe_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_disambiguation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
