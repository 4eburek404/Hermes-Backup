{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_search_plan.v1.schema.json",
  "title": "Flight Search Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary_offer_queries",
    "mandatory_controls",
    "gateway_discovery",
    "gateway_leg_queries",
    "fallback_segment_plan",
    "coverage_expectations"
  ],
  "properties": {
    "schema_version": {"const": "flight_search_plan.v1"},
    "primary_offer_queries": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "mandatory_controls": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "gateway_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "reason",
        "mode",
        "route_access_profile",
        "route_access_reasons",
        "candidate_count",
        "candidates",
        "skipped_reasons",
        "empty_reason"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "mode": {"type": "string"},
        "route_access_profile": {"type": ["string", "null"]},
        "route_access_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidates": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "skipped_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "empty_reason": {"type": ["string", "null"]},
        "prior_set": {"type": "string"},
        "matched_rule_id": {"type": "string"},
        "market": {"type": "string"},
        "rejected_gateway_signals": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "gateway_leg_queries": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "fallback_segment_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments"],
      "properties": {
        "segments": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "coverage_expectations": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    }
  }
}
