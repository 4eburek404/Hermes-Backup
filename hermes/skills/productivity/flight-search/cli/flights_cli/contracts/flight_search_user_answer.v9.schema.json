{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_search_user_answer.v9.schema.json",
  "title": "Flight Search User Answer v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_mode",
    "catalog",
    "primary_option_id",
    "alternative_option_ids",
    "evidence_status",
    "required_caveats",
    "stop_policy_status",
    "rendered_text"
  ],
  "properties": {
    "schema_version": {
      "const": "flight_search_user_answer.v9"
    },
    "answer_mode": {
      "enum": [
        "catalog",
        "no_viable_options"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation",
        "items"
      ],
      "properties": {
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style",
            "language",
            "max_items"
          ],
          "properties": {
            "style": {
              "const": "numbered_inline_itinerary_v1"
            },
            "language": {
              "const": "ru"
            },
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalog_item"
          }
        }
      }
    },
    "primary_option_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "alternative_option_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_complete",
        "execution_complete",
        "evidence_complete",
        "answerability",
        "planned_control_count",
        "terminal_control_count",
        "not_executed_control_count",
        "failed_control_count",
        "not_supported_control_count",
        "provider_failure_count",
        "through_fare_check_count",
        "blocking_evidence",
        "non_blocking_boundaries"
      ],
      "properties": {
        "coverage_complete": {
          "type": "boolean"
        },
        "execution_complete": {
          "type": "boolean"
        },
        "evidence_complete": {
          "type": "boolean"
        },
        "answerability": {
          "enum": [
            "answerable",
            "answerable_with_caveats",
            "needs_more_evidence"
          ]
        },
        "planned_control_count": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_control_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_executed_control_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_control_count": {
          "type": "integer",
          "minimum": 0
        },
        "provider_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "through_fare_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_supported_control_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_blocking_boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_caveats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_boundaries_included",
        "coverage_incompleteness_acknowledged",
        "provider_failures_acknowledged",
        "through_fare_verification_required",
        "purchase_screen_verification_required"
      ],
      "properties": {
        "source_boundaries_included": {
          "type": "boolean"
        },
        "coverage_incompleteness_acknowledged": {
          "type": "boolean"
        },
        "provider_failures_acknowledged": {
          "type": "boolean"
        },
        "through_fare_verification_required": {
          "type": "boolean"
        },
        "purchase_screen_verification_required": {
          "type": "boolean"
        }
      }
    },
    "stop_policy_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "max_reported_connections",
        "two_stop_tier_used",
        "three_plus_suppressed_count",
        "garbage_options_suppressed"
      ],
      "properties": {
        "policy": {
          "type": "string"
        },
        "max_reported_connections": {
          "type": "integer",
          "minimum": 0
        },
        "two_stop_tier_used": {
          "type": "boolean"
        },
        "three_plus_suppressed_count": {
          "type": "integer",
          "minimum": 0
        },
        "garbage_options_suppressed": {
          "type": "boolean"
        }
      }
    },
    "rendered_text": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "provider_aggregate_time_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itinerary_elapsed_min",
        "flight_time_min",
        "layover_total_min"
      ],
      "properties": {
        "itinerary_elapsed_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "flight_time_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "layover_total_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "catalog_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "option_id",
        "covers_requested_trip",
        "journey_scope",
        "ticketing_model",
        "detail_status",
        "total_price",
        "directions",
        "baggage",
        "protection",
        "badges",
        "caveats",
        "evidence_refs",
        "connection_assessment",
        "ticket_protection"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "covers_requested_trip": {
          "type": "boolean"
        },
        "journey_scope": {
          "enum": [
            "one_way",
            "round_trip",
            "outbound_only",
            "return_only",
            "two_one_way_pair"
          ]
        },
        "ticketing_model": {
          "enum": [
            "single_ticket_proven",
            "provider_aggregate",
            "separate_one_way_offers",
            "separate_segments",
            "unknown"
          ]
        },
        "detail_status": {
          "enum": [
            "full",
            "summary_only",
            "missing"
          ]
        },
        "total_price": {
          "$ref": "#/$defs/price_summary"
        },
        "directions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outbound",
            "return"
          ],
          "properties": {
            "outbound": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/direction_detail"
                }
              ]
            },
            "return": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/direction_detail"
                }
              ]
            }
          }
        },
        "baggage": {
          "$ref": "#/$defs/baggage_summary"
        },
        "protection": {
          "$ref": "#/$defs/protection_summary"
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": [
                "number",
                "null"
              ]
            },
            "grade": {
              "type": [
                "string",
                "null"
              ]
            },
            "reject": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "top_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "self_transfer_source": {
              "type": [
                "string",
                "null"
              ]
            },
            "self_transfer_note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connection_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "comfort",
            "connections"
          ],
          "properties": {
            "status": {
              "enum": [
                "valid",
                "invalid",
                "unknown"
              ]
            },
            "comfort": {
              "enum": [
                "comfortable",
                "acceptable",
                "long",
                "tight",
                "unknown",
                "invalid"
              ]
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "ticket_protection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "protected",
                "unprotected",
                "unknown"
              ]
            },
            "source": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "price_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "source",
        "confidence"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "live_provider",
            "provider_aggregate",
            "cache",
            "web",
            "manual",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      }
    },
    "direction_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail_status",
        "segments",
        "layovers",
        "elapsed_min"
      ],
      "properties": {
        "detail_status": {
          "enum": [
            "full",
            "summary_only",
            "missing"
          ]
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/catalog_segment"
          }
        },
        "layovers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalog_layover"
          }
        },
        "elapsed_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "catalog_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flight_number",
        "carrier",
        "origin",
        "destination",
        "departure_at",
        "arrival_at",
        "aircraft_code",
        "duration_min",
        "origin_label",
        "destination_label"
      ],
      "properties": {
        "flight_number": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "carrier": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9]{2,3}$"
        },
        "origin": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "departure_terminal": {
          "type": [
            "string",
            "null"
          ]
        },
        "arrival_terminal": {
          "type": [
            "string",
            "null"
          ]
        },
        "departure_at": {
          "type": "string",
          "format": "date-time"
        },
        "arrival_at": {
          "type": "string",
          "format": "date-time"
        },
        "aircraft_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "origin_label": {
          "type": "string",
          "minLength": 1
        },
        "destination_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalog_layover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "airport",
        "duration_min"
      ],
      "properties": {
        "airport": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "duration_min": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baggage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "cabin",
        "source",
        "confidence"
      ],
      "properties": {
        "checked": {
          "type": "string"
        },
        "cabin": {
          "type": "string"
        },
        "source": {
          "enum": [
            "fare_family",
            "provider_offer",
            "web",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      }
    },
    "protection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_pnr_status",
        "through_baggage_status",
        "self_transfer",
        "purchase_screen_verification_required"
      ],
      "properties": {
        "single_pnr_status": {
          "enum": [
            "proven",
            "unproven",
            "unknown",
            "not_applicable"
          ]
        },
        "through_baggage_status": {
          "enum": [
            "proven",
            "unproven",
            "unknown",
            "not_applicable"
          ]
        },
        "self_transfer": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "purchase_screen_verification_required": {
          "type": "boolean"
        }
      }
    }
  }
}
