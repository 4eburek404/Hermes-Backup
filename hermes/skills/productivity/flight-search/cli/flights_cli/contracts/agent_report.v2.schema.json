{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes:flights-cli:agent-report:v2",
  "title": "Hermes Flights CLI Agent Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route", "evidence", "frontier", "user_answer", "agent_guidance", "diagnostics"],
  "properties": {
    "schema_version": {"const": "agent_report.v2"},
    "route": {"$ref": "#/$defs/route"},
    "evidence": {"$ref": "#/$defs/search_evidence"},
    "frontier": {"$ref": "#/$defs/offer_frontier"},
    "user_answer": {"type": "object"},
    "agent_guidance": {"$ref": "#/$defs/agent_guidance"},
    "diagnostics": {"$ref": "#/$defs/diagnostics"}
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": true,
      "required": ["origin", "destination", "dates"],
      "properties": {
        "origin": {"type": ["string", "null"]},
        "destination": {"type": ["string", "null"]},
        "origin_airports": {"type": "array"},
        "destination_airports": {"type": "array"},
        "dates": {"type": "object"},
        "profile": {"type": ["string", "null"]},
        "routing_strategy": {"type": ["string", "null"]},
        "provider_policy": {"type": ["string", "null"]}
      }
    },
    "search_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_boundaries",
        "hub_viability",
        "segment_searches",
        "provider_failures",
        "aggregate_controls",
        "coverage_diagnostics",
        "through_fare_checks",
        "rejected_pair_warnings",
        "stop_policy",
        "stop_policy_diagnostics"
      ],
      "properties": {
        "source_boundaries": {"type": "array", "items": {"type": "string"}},
        "hub_viability": {"type": "array"},
        "segment_searches": {"type": "array"},
        "provider_failures": {"type": "array"},
        "aggregate_controls": {"type": "array"},
        "coverage_diagnostics": {"$ref": "#/$defs/coverage_diagnostics"},
        "through_fare_checks": {"type": "array"},
        "rejected_pair_warnings": {"type": "array"},
        "stop_policy": {"type": "object"},
        "stop_policy_diagnostics": {"type": "object"},
        "ru_priority_controls": {"type": "object"},
        "date_window_inventory": {"type": "object"},
        "direct_flights": {"type": "array"}
      }
    },
    "coverage_diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "coverage_mode",
        "negative_evidence_type",
        "planned_controls",
        "searched_controls",
        "skipped_controls",
        "failed_controls",
        "not_supported_controls",
        "not_executed_controls",
        "deduped_controls",
        "completeness"
      ],
      "properties": {
        "coverage_mode": {"type": ["string", "null"]},
        "negative_evidence_type": {"type": ["string", "null"]},
        "planned_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "planned"}}}},
        "searched_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "searched"}}}},
        "skipped_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "skipped"}}}},
        "failed_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "failed"}, "status": {"const": "failed"}}}},
        "not_supported_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "not_supported"}, "status": {"const": "not_supported"}}}},
        "not_executed_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "not_executed"}, "status": {"const": "not_executed"}}}},
        "deduped_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true, "properties": {"execution_state": {"const": "deduped"}, "status": {"const": "deduped"}}}},
        "coverage_warnings": {"type": "array"},
        "limits": {"type": "object"},
        "completeness": {
          "type": "object",
          "additionalProperties": true,
          "required": ["planned_count", "terminal_count", "all_planned_controls_have_terminal_state"],
          "properties": {
            "planned_count": {"type": "integer"},
            "terminal_count": {"type": "integer"},
            "all_planned_controls_have_terminal_state": {"type": "boolean"}
          }
        }
      }
    },
    "offer_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "offer_graph", "recommended_options", "priority_options"],
      "properties": {
        "status": {"type": "object"},
        "offer_graph": {"type": "object"},
        "recommended_options": {"type": "array"},
        "priority_options": {"type": "array"}
      }
    },
    "agent_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_command",
        "canonical_answer_path",
        "answer_readiness",
        "execution_complete",
        "evidence_complete",
        "blocking_evidence",
        "non_blocking_boundaries",
        "next_actions"
      ],
      "properties": {
        "primary_command": {"const": "search --request"},
        "canonical_answer_path": {"const": "data.agent_report.user_answer.rendered_text"},
        "answer_readiness": {
          "enum": ["answerable", "answerable_with_caveats", "needs_more_evidence"]
        },
        "execution_complete": {"type": "boolean"},
        "evidence_complete": {"type": "boolean"},
        "blocking_evidence": {"type": "array", "items": {"type": "string"}},
        "non_blocking_boundaries": {"type": "array", "items": {"type": "string"}},
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "reason"],
            "properties": {
              "id": {"type": "string"},
              "reason": {"type": "string"},
              "request_patch": {"type": "object"},
              "answer_path": {"type": "string"},
              "external_evidence_required": {"type": "boolean"}
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "answer_lines", "human_answer"],
      "properties": {
        "display": {"type": "object"},
        "answer_lines": {"type": "array", "items": {"type": "string"}},
        "human_answer": {"type": "object"},
        "omitted_counts": {"type": "object"}
      }
    }
  }
}
