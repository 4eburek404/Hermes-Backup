{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_search_request.v1.schema.json",
  "title": "Flight Search Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin", "destination", "depart_date"],
  "properties": {
    "schema_version": {"const": "flight_search_request.v1"},
    "origin": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "destination": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "depart_date": {"type": "string", "format": "date"},
    "return_date": {"type": ["string", "null"], "format": "date"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "profile": {"type": "string", "const": "business"},
    "ticketing": {"type": "string", "enum": ["separate", "single"]},
    "provider_policy": {"type": "string", "enum": ["auto", "kupibilet", "fli", "tutu"]},
    "route_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hubs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
        "routing_strategy": {"type": "string", "enum": ["auto", "hub-list", "ru-priority", "domestic-ru"]},
        "origin_airports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
        "destination_airports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
        "max_airports_per_city": {"type": "integer", "minimum": 1},
        "coverage_mode": {"type": "string", "enum": ["standard", "targeted", "full"]},
        "coverage_controls": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "coverage_control_limit": {"type": "integer", "minimum": 0},
        "min_same_airport_min": {"type": "integer", "minimum": 0},
        "min_cross_airport_min": {"type": "integer", "minimum": 0},
        "stop_policy": {"type": "string", "enum": ["business-default", "strict-direct-one-stop", "allow-two-stop-tier", "debug-all"]},
        "date_window_end": {"type": ["string", "null"], "format": "date"},
        "max_connections": {"type": ["integer", "null"], "minimum": 0},
        "tier2_max_connections": {"type": ["integer", "null"], "minimum": 0},
        "use_gateway_discovery_for_fallback_hubs": {"type": "boolean"},
        "gateway_discovery_limit": {"type": "integer", "minimum": 0},
        "gateway_probe_batch_size": {"type": "integer", "minimum": 0},
        "gateway_probe_max_batches": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segment_limit": {"type": "integer", "minimum": 1},
        "timeout": {"type": "integer", "minimum": 1},
        "outbound_second_leg_day_offsets": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "return_second_leg_day_offsets": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "search_wave_max_waves": {"type": "integer", "minimum": 1},
        "search_wave_probe_limit": {"type": "integer", "minimum": 1},
        "search_wave_top_k": {"type": "integer", "minimum": 1},
        "aggregate_control_limit": {"type": "integer", "minimum": 0},
        "aggregate_control_carriers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]{2,3}$"}},
        "max_segment_searches": {"type": "integer", "minimum": 1},
        "fail_fast": {"type": "boolean"},
        "live_cache_ttl_seconds": {"type": "integer", "minimum": 0},
        "no_live_cache": {"type": "boolean"},
        "fli_mcp_url": {"type": "string", "format": "uri"}
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "only_carriers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]{2,3}$"}},
        "exclude_carriers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]{2,3}$"}},
        "prefer_carriers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]{2,3}$"}},
        "avoid_carriers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]{2,3}$"}}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_limit": {"type": "integer", "minimum": 1},
        "direct_catalog_limit": {"type": "integer", "minimum": 1}
      }
    }
  }
}
