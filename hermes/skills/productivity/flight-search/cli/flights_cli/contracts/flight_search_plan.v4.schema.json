{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_search_plan.v4.schema.json",
  "title": "Flight Search Plan v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_context",
    "primary_offer_queries",
    "gateway_discovery",
    "conditional_gateway_queries",
    "coverage_expectations",
    "execution_limits",
    "output_limits",
    "planning_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "flight_search_plan.v4"
    },
    "route_context": {
      "$ref": "#/$defs/route_context"
    },
    "primary_offer_queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probe_intent"
      }
    },
    "gateway_discovery": {
      "$ref": "#/$defs/gateway_discovery"
    },
    "conditional_gateway_queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probe_intent"
      }
    },
    "coverage_expectations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage_expectation"
      }
    },
    "execution_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_segment_searches",
        "segment_limit",
        "live_cache_ttl_seconds",
        "live_cache_enabled",
        "timeout",
        "fail_fast"
      ],
      "properties": {
        "max_segment_searches": {
          "type": "integer",
          "minimum": 1
        },
        "segment_limit": {
          "type": "integer",
          "minimum": 1
        },
        "live_cache_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "live_cache_enabled": {
          "type": "boolean"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "fail_fast": {
          "type": "boolean"
        }
      }
    },
    "output_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_limit",
        "direct_catalog_limit"
      ],
      "properties": {
        "catalog_limit": {
          "type": "integer",
          "minimum": 1
        },
        "direct_catalog_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "planning_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "route_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "destination",
        "dates",
        "currency",
        "profile",
        "provider_policy",
        "routing_strategy",
        "route_mode",
        "market_class",
        "route_families",
        "hubs",
        "origin_airports",
        "destination_airports",
        "direct_only"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "depart",
            "return"
          ],
          "properties": {
            "depart": {
              "type": "string",
              "format": "date"
            },
            "return": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "window_end": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "currency": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "provider_policy": {
          "type": "string"
        },
        "routing_strategy": {
          "type": "string"
        },
        "route_mode": {
          "type": "string"
        },
        "market_class": {
          "type": "string"
        },
        "route_families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hubs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin_airports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destination_airports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "airport_scope": {
          "type": [
            "object",
            "null"
          ]
        },
        "direct_only": {
          "type": "boolean"
        }
      }
    },
    "probe_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_type",
        "probe_type",
        "direction",
        "origin",
        "destination",
        "date",
        "currency",
        "direct_only",
        "execution_state"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "probe_type": {
          "type": "string"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": "string"
        },
        "leg": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "origin_airports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destination_airports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "return_date": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string"
        },
        "direct_only": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "execution_state": {
          "type": "string"
        },
        "route_family": {
          "type": "string"
        },
        "route_access_profile": {
          "type": "string"
        },
        "gateway_discovery_mode": {
          "type": "string"
        },
        "exhaustive": {
          "type": "boolean"
        },
        "non_exhaustive_reason": {
          "type": "string"
        },
        "only_carriers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateway": {
          "type": "string"
        },
        "gateway_role": {
          "type": "string"
        },
        "connection_layer": {
          "type": "string"
        },
        "allows_intermediate_hubs": {
          "type": "boolean"
        },
        "date_strategy": {
          "type": "string"
        },
        "gateway_rank": {
          "type": "integer",
          "minimum": 1
        },
        "gateway_source": {
          "type": "string"
        },
        "candidate_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "gateway_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "reason",
        "mode",
        "route_access_profile",
        "route_access_reasons",
        "candidate_count",
        "candidates",
        "skipped_reasons",
        "empty_reason"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string"
        },
        "route_access_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_access_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateway_candidate"
          }
        },
        "skipped_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "empty_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "prior_set": {
          "type": "string"
        },
        "matched_rule_id": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "rejected_gateway_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_gateway_signal"
          }
        }
      }
    },
    "coverage_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "route_access_profile",
        "gateway_discovery_mode",
        "source_type",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "route_access_profile": {
          "type": "string"
        },
        "gateway_discovery_mode": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "gateway_debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "market": {
          "type": "string"
        },
        "allow_as_gateway": {
          "type": "boolean"
        },
        "source_path": {
          "type": "string"
        },
        "journey_index": {
          "type": "integer",
          "minimum": 0
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "between_segments": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "ground_transfer_required": {
          "type": "boolean"
        },
        "static_prior_not_ranked": {
          "type": "boolean"
        },
        "allow_as_gateway_required": {
          "type": "boolean"
        }
      }
    },
    "gateway_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "weight",
        "reason"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "provider": {
          "type": "string"
        },
        "offer_id": {
          "type": "string"
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "debug": {
          "$ref": "#/$defs/gateway_debug"
        }
      }
    },
    "gateway_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "score",
        "signals",
        "risk_flags"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "score": {
          "type": "number"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateway_signal"
          }
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debug": {
          "$ref": "#/$defs/gateway_debug"
        }
      }
    },
    "rejected_gateway_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reason"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "provider": {
          "type": "string"
        },
        "offer_id": {
          "type": "string"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "arrival_airport": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "next_departure_airport": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "control_layer": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "debug": {
          "$ref": "#/$defs/gateway_debug"
        }
      }
    }
  }
}
