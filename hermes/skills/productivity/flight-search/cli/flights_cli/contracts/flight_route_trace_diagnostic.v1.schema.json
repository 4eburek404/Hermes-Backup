{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/flights/flight_route_trace_diagnostic.v1.schema.json",
  "title": "Flight Route Trace Diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "route_trace", "agent_report"],
  "properties": {
    "schema_version": {"const": "flight_route_trace_diagnostic.v1"},
    "request": {"type": "object"},
    "route_trace": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "flight_route_trace_diagnostic.v1"}
      },
      "required": ["schema_version"]
    },
    "agent_report": {
      "type": ["object", "null"],
      "properties": {
        "schema_version": {"const": "agent_report.v5"}
      },
      "required": ["schema_version"]
    }
  }
}
