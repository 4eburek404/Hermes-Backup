{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes:flights-cli:agent-report:v5",
  "title": "Hermes Flights CLI Agent Report v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route", "evidence", "frontier", "user_answer", "agent_guidance"],
  "properties": {
    "schema_version": {"const": "agent_report.v5"},
    "route": {"$ref": "#/$defs/route"},
    "evidence": {"$ref": "#/$defs/compact_evidence"},
    "frontier": {"$ref": "#/$defs/frontier"},
    "user_answer": {"type": "object"},
    "agent_guidance": {"$ref": "#/$defs/agent_guidance"}
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "destination", "dates"],
      "properties": {
        "origin": {"type": ["string", "null"]},
        "destination": {"type": ["string", "null"]},
        "origin_airports": {"type": "array"},
        "destination_airports": {"type": "array"},
        "dates": {"type": "object"},
        "profile": {"type": ["string", "null"]},
        "routing_strategy": {"type": ["string", "null"]},
        "provider_policy": {"type": ["string", "null"]}
      }
    },
    "compact_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_boundaries", "coverage", "provider_failures", "through_fare_checks", "direct_flights"],
      "properties": {
        "source_boundaries": {"type": "array", "items": {"type": "string"}},
        "coverage": {"$ref": "#/$defs/compact_coverage"},
        "provider_failures": {"type": "array"},
        "through_fare_checks": {"type": "array"},
        "direct_flights": {"type": "array"},
        "ru_priority_controls": {"type": "object"},
        "date_window_inventory": {"type": "object"}
      }
    },
    "compact_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_mode",
        "negative_evidence_type",
        "coverage_warnings",
        "limits",
        "counts",
        "completeness",
        "blocking_evidence",
        "non_blocking_boundaries"
      ],
      "properties": {
        "coverage_mode": {"type": ["string", "null"]},
        "negative_evidence_type": {"type": ["string", "null"]},
        "coverage_warnings": {"type": "array"},
        "limits": {"type": "object"},
        "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planned_count", "terminal_count", "all_planned_controls_have_terminal_state"],
          "properties": {
            "planned_count": {"type": "integer"},
            "terminal_count": {"type": "integer"},
            "all_planned_controls_have_terminal_state": {"type": "boolean"}
          }
        },
        "blocking_evidence": {"type": "array", "items": {"type": "string"}},
        "non_blocking_boundaries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_frontier"],
      "properties": {
        "decision_frontier": {"$ref": "#/$defs/public_decision_frontier"}
      }
    },
    "public_decision_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "options", "controls", "coverage_summary"],
      "properties": {
        "schema_version": {"const": "flight_decision_frontier.public.v1"},
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/public_frontier_option"}
        },
        "controls": {"type": "array", "items": {"type": "object"}},
        "coverage_summary": {"type": "object"}
      }
    },
    "public_frontier_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "rank": {"type": ["integer", "null"]},
        "selection_reasons": {"type": "array", "items": {"type": "string"}},
        "source_type": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "source_providers": {"type": "array", "items": {"type": "string"}},
        "gateway": {"type": ["string", "null"]},
        "covers_requested_trip": {"type": "boolean"},
        "journey_scope": {"type": ["string", "null"]},
        "price": {"type": ["number", "null"]},
        "currency": {"type": ["string", "null"]},
        "price_basis": {"type": ["string", "null"]},
        "ticketing_model": {"type": ["string", "null"]},
        "detail_status": {"type": ["string", "null"]},
        "connection_count": {"type": ["integer", "null"]},
        "catalog_item_number": {"type": "integer"},
        "catalog_item_path": {"type": "string"},
        "evidence_sources": {"type": "array", "items": {"type": "object"}},
        "price_comparison": {"type": "object"}
      }
    },
    "agent_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_command",
        "canonical_answer_path",
        "answer_readiness",
        "execution_complete",
        "evidence_complete",
        "blocking_evidence",
        "non_blocking_boundaries",
        "next_actions"
      ],
      "properties": {
        "primary_command": {"const": "search --request"},
        "canonical_answer_path": {"const": "data.agent_report.user_answer.rendered_text"},
        "answer_readiness": {
          "enum": ["answerable", "answerable_with_caveats", "needs_more_evidence"]
        },
        "execution_complete": {"type": "boolean"},
        "evidence_complete": {"type": "boolean"},
        "blocking_evidence": {"type": "array", "items": {"type": "string"}},
        "non_blocking_boundaries": {"type": "array", "items": {"type": "string"}},
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "reason"],
            "properties": {
              "id": {"type": "string"},
              "reason": {"type": "string"},
              "request_patch": {"type": "object"},
              "answer_path": {"type": "string"},
              "external_evidence_required": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
